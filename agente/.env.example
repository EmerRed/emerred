# Clave de API de Google Gemini (Obtén una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo por defecto (ejemplos: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
DEFAULT_MODEL=gemini-2.5-flash

# Opciones adicionales de configuración
MAX_SEARCH_RESULTS=5
MAX_ARTICLE_CHARS=12000
OUTPUTS_DIR=outputs
DATA_DIR=data

# Configuración del Endpoint de Emergencia (EmerRed)
EMERRED_API_URL=https://api.emerred.org.co/afectado
EMERRED_API_KEY=tu_token_de_autenticacion_aqui
EMERRED_TIMEOUT_SECONDS=10
EMERRED_MAX_RETRIES=3
EMERRED_OFFLINE_BUFFER_ENABLED=true
EMERRED_BUFFER_PATH=data/emergency_buffer.json

