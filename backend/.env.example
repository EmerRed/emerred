# Desarrollo local
MONGODB_URI=mongodb://localhost:27017/emerred_db
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Producción (Railway) - estas variables se configuran en el dashboard de Railway
# MONGODB_URI=mongodb://mongo:27017/emerred_db  (Docker Compose local)
# MONGODB_URI=mongodb://<host>:<port>/<database>  (Railway MongoDB plugin)
# PORT=3000  (Asignado automáticamente por Railway)
# NODE_ENV=production
# CORS_ORIGIN=https://tu-frontend.railway.app